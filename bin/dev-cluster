#!/usr/bin/env bash
# Run a2astro locally against the resident agents on a real cluster.
#
# Each agent's A2A listener is a ClusterIP Service, so `kubectl port-forward`
# reaches it through the API server rather than pod-to-pod networking — which
# means the operator's `allow-forge-gateway-a2a` NetworkPolicy is not in the
# path and no cluster-side grant is needed to develop against live agents.
#
# The bearer tokens are the ones agent-operator already recorded in the
# organization Secret. They are read straight into a git-ignored file; nothing
# is printed.
#
#   bin/dev-cluster                 # ks agents on the default context
#   ORG=artera AGENTS="vega luce" bin/dev-cluster
#   CATALOG_URI=https://example.test/org/.agents.git CATALOG_REVISION=v1 bin/dev-cluster
#
set -euo pipefail

CONTEXT="${CONTEXT:-default}"
ORG="${ORG:-ks}"
AGENTS="${AGENTS:-vega luce drago}"
BASE_PORT="${BASE_PORT:-8788}"
DEFAULT_AGENT="${DEFAULT_AGENT:-}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROUTES="$ROOT/data/forge-routes.json"
CONFIG="$ROOT/a2astro.config.yaml"

command -v kubectl >/dev/null || { echo "kubectl is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
mkdir -p "$ROOT/data"

echo "Reading agent tokens from $ORG/organization-credentials…"
umask 077
kubectl --context "$CONTEXT" -n "org-$ORG" get secret organization-credentials \
  -o "jsonpath={.data.forge-routes\\.json}" | base64 -d > "$ROUTES"
[ -s "$ROUTES" ] || { echo "no forge-routes.json in org-$ORG/organization-credentials" >&2; exit 1; }

pids=()
started_server=0
cleanup() {
  for pid in "${pids[@]:-}"; do kill "$pid" 2>/dev/null || true; done
  if [ "$started_server" -eq 1 ]; then
    (cd "$ROOT" && npm run astro -- dev stop >/dev/null 2>&1) || true
  fi
}
trap cleanup EXIT INT TERM

# Draw workflows from every exact catalog revision reconciled by the live
# Organization. The in-cluster Forgejo hostname is not resolvable locally, so
# translate its canonical service URL to the public read endpoint. A complete
# URI/revision override remains available for other environments.
catalog_rows=()
if [ -n "${CATALOG_URI:-}" ] || [ -n "${CATALOG_REVISION:-}" ]; then
  [ -n "${CATALOG_URI:-}" ] && [ -n "${CATALOG_REVISION:-}" ] || {
    echo "CATALOG_URI and CATALOG_REVISION must be set together" >&2
    exit 1
  }
  catalog_rows+=("$CATALOG_URI"$'\t'"$CATALOG_REVISION"$'\t'"${CATALOG_PATH:-.}")
else
  mapfile -t catalog_rows < <(
    kubectl --context "$CONTEXT" get organization "$ORG" -o json |
      jq -r '.spec.agentCatalogs[]? | [.uri, .revision, (.path // ".")] | @tsv'
  )
fi
[ "${#catalog_rows[@]}" -gt 0 ] || {
  echo "Organization/$ORG has no agent catalogs; set CATALOG_URI and CATALOG_REVISION" >&2
  exit 1
}

{
  echo "dataDir: ./data"
  echo "catalogs:"
  for catalog_row in "${catalog_rows[@]}"; do
    IFS=$'\t' read -r catalog_uri catalog_revision catalog_path <<< "$catalog_row"
    case "$catalog_uri" in
      git+http://host-forgejo.default.svc.cluster.local:3001/*)
        catalog_uri="https://git.ncrmro.com/${catalog_uri#git+http://host-forgejo.default.svc.cluster.local:3001/}"
        ;;
    esac
    [ -n "$catalog_uri" ] && [ -n "$catalog_revision" ] || {
      echo "Organization/$ORG contains an incomplete agent catalog" >&2
      exit 1
    }
    echo "  - uri: $catalog_uri"
    echo "    revision: $catalog_revision"
    if [ "$catalog_path" != "." ]; then
      echo "    path: $catalog_path"
    fi
  done
  echo "agents:"
} > "$CONFIG"

port=$BASE_PORT
configured_agents=()
for agent in $AGENTS; do
  namespace="agent-$ORG-$agent"
  if ! kubectl --context "$CONTEXT" -n "$namespace" get svc agent-runtime >/dev/null 2>&1; then
    echo "skipping $agent: no agent-runtime Service in $namespace" >&2
    continue
  fi
  kubectl --context "$CONTEXT" -n "$namespace" port-forward svc/agent-runtime "$port:8788" >/dev/null 2>&1 &
  pids+=("$!")
  echo "  $agent → 127.0.0.1:$port ($namespace)"
  configured_agents+=("$ORG-$agent")
  cat >> "$CONFIG" <<YAML
  - id: $ORG-$agent
    name: $(tr '[:lower:]' '[:upper:]' <<< "${agent:0:1}")${agent:1}
    a2a:
      url: http://127.0.0.1:$port
      tokenFile: ./data/forge-routes.json
      tokenUsername: $agent
    deployment: {cluster: $CONTEXT, namespace: $namespace}
YAML
  port=$((port + 1))
done

[ "${#configured_agents[@]}" -gt 0 ] || {
  echo "no requested resident agent has an agent-runtime Service" >&2
  exit 1
}
if [ -z "$DEFAULT_AGENT" ]; then
  DEFAULT_AGENT="${configured_agents[0]}"
fi
if [[ " ${configured_agents[*]} " != *" $DEFAULT_AGENT "* ]]; then
  echo "DEFAULT_AGENT=$DEFAULT_AGENT is not among the configured agents: ${configured_agents[*]}" >&2
  exit 1
fi
echo "defaultAgent: $DEFAULT_AGENT" >> "$CONFIG"

echo "Waiting for the tunnels…"
sleep 3
for p in $(seq "$BASE_PORT" $((port - 1))); do
  code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$p/.well-known/agent-card.json" || echo 000)
  echo "  127.0.0.1:$p agent card → $code"
done

echo "Starting a2astro with $CONFIG"
cd "$ROOT"
if npm run astro -- dev status 2>&1 | grep -q 'Dev server running'; then
  echo "Reusing this checkout's running a2astro server"
else
  npm run astro -- dev --background
  started_server=1
fi

echo "a2astro and the agent tunnels are running; press Ctrl-C to stop them"
set +e
wait -n "${pids[@]}"
status=$?
set -e
if [ "$status" -ne 130 ]; then
  echo "an agent tunnel exited (status $status)" >&2
fi
exit "$status"
